# Variables de entorno para correr Frances Classroom en local.
# Copia este archivo a .env (git lo ignora) y llena los valores.
# Nunca commitees valores reales. Para producción usa infra/env.example.

# --- Obligatorias ---
# Origen de la web. En local es el de Vite.
FRANCES_PUBLIC_ORIGIN=http://localhost:5173
# Carpeta de datos (frances.toml, state.db, blobs/, audio/). Ruta absoluta.
FRANCES_DATA_DIR=/ruta/a/frances-data
FRANCES_STATE_DB=/ruta/a/frances-data/state.db

# --- Google Classroom y Drive (solo lectura) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

# --- LLM con API compatible con OpenAI (ADR-016). Vacío = todo por reglas ---
LLM_BASE_URL=https://llm.onerouter.pro/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b:free

# --- Azure: pronunciación, TTS de respaldo y traductor ---
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=brazilsouth

# --- Backup en Oracle Object Storage (opcional en local) ---
FRANCES_BACKUP_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
FRANCES_BACKUP_REGION=sa-bogota-1
FRANCES_BACKUP_BUCKET=<bucket>
FRANCES_BACKUP_ACCESS_KEY_ID=
FRANCES_BACKUP_SECRET_ACCESS_KEY=
