{
	email {$FRANCES_ACME_EMAIL}
}

{$FRANCES_DOMAIN} {
	# `text/event-stream` (chat) no se comprime: gzip/zstd amortigua el flujo
	# y rompe la entrega incremental de tokens.
	@compressible not path /api/chat/*
	encode @compressible zstd gzip

	request_body /api/* {
		max_size 1MB
	}

	header {
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), geolocation=(), microphone=(self)"
		-Server
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; font-src 'self'; img-src 'self' data: blob:; media-src 'self' blob:; connect-src 'self' wss://*.stt.speech.microsoft.com; worker-src 'self' blob:; frame-ancestors 'none'; base-uri 'none'; form-action 'self'"
	}

	handle /api/* {
		reverse_proxy api:8000 {
			flush_interval -1
		}
	}

	handle /assets/* {
		header Cache-Control "public, max-age=31536000, immutable"
		root * /srv/web
		file_server
	}

	handle {
		header Cache-Control "no-cache"
		root * /srv/web
		try_files {path} /index.html
		file_server
	}
}
