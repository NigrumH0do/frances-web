# Variables de Caddy. Copiar a /srv/frances/caddy.env con permisos 644.
# No contiene secretos: Caddy no recibe /srv/frances/.env.
# No hace falta AZURE_SPEECH_REGION: la CSP usa el comodín
# wss://*.stt.speech.microsoft.com del pool multicuenta (ADR-022).

FRANCES_DOMAIN=frances.example.org
FRANCES_ACME_EMAIL=admin@example.org
