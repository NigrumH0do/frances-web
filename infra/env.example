# Variables de entorno de la API, el worker y el backup.
# Copiar a /srv/frances/.env con permisos 600 y dueño root. Nunca commitear valores reales.

FRANCES_PUBLIC_ORIGIN=https://frances.example.org
FRANCES_DATA_DIR=/data
FRANCES_STATE_DB=/data/state.db

FRANCES_BACKUP_ENDPOINT=https://<namespace>.compat.objectstorage.<region>.oraclecloud.com
FRANCES_BACKUP_REGION=sa-bogota-1
FRANCES_BACKUP_BUCKET=<bucket>
FRANCES_BACKUP_ACCESS_KEY_ID=
FRANCES_BACKUP_SECRET_ACCESS_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=

AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=brazilsouth
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=brazilsouth

LLM_BASE_URL=https://llm.onerouter.pro/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b:free
